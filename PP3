import java.util.*;

class Student {
    String roll;
    String name;

    Student(String roll, String name) {
        this.roll = roll;
        this.name = name;
    }

    public boolean equals(Object o) {
        if (!(o instanceof Student)) return false;
        return roll.equals(((Student) o).roll);
    }

    public int hashCode() {
        return roll.hashCode();
    }
}

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        Set<Student> students = new HashSet<>();

        while (sc.hasNext()) {
            String op = sc.next();
            String roll = sc.next();
            String name = sc.next();
            Student s = new Student(roll, name);

            if (op.equals("ADD")) {
                if (students.add(s))
                    System.out.println("Added");
                else
                    System.out.println("duplicate rejected");
            } else if (op.equals("CONTAINS")) {
                System.out.println("contains: " + students.contains(s));
            }
        }

        System.out.println("member count " + students.size());
        sc.close();
    }
}
